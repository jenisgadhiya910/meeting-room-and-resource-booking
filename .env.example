# Credentials for the `db` service in docker-compose.yml.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=meeting_rooms

# Host-side port the `db` container is published on. Defaults to 5433 (not
# 5432) because a local Postgres install commonly already owns 5432.
POSTGRES_PORT=5433

# Connection string for host-side tooling — `yarn dev`, `yarn db:studio`, and
# the `yarn verify:*` scripts' cleanup — which reach the `db` container at
# localhost:$POSTGRES_PORT. Keep user/password/db and the port in sync with the
# values above. The `web` container does not read this: docker-compose.yml
# builds its own URL (`db:5432`) from the POSTGRES_* values.
DATABASE_URL=postgresql://app:app@localhost:5433/meeting_rooms

# Signs and verifies the session JWT. At least 32 characters; generate one
# with `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Rotating it invalidates every existing session. Required — `docker compose up`
# refuses to start until it is set.
SESSION_SECRET=
