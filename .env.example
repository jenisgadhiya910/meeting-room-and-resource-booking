# Credentials for the `db` service in docker-compose.yml.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=meeting_rooms

# Host-side port the `db` container is published on. Defaults to 5433 (not
# 5432) because a local Postgres install commonly already owns 5432.
POSTGRES_PORT=5433

# Connection string the Next.js app uses to reach Postgres. When running
# `yarn dev` on the host against `docker compose up db`, the database is
# reachable at localhost:$POSTGRES_PORT — keep user/password/db and the port
# in sync with the values above.
DATABASE_URL=postgresql://app:app@localhost:5433/meeting_rooms

# Signs and verifies the session JWT. At least 32 characters; generate one
# with `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Rotating it invalidates every existing session.
SESSION_SECRET=
